{
  "name": "DirectMessageThread",
  "type": "object",
  "properties": {
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of both participants"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of both participants"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last message"
    },
    "last_message_preview": {
      "type": "string",
      "description": "Short preview of last message"
    },
    "last_message_sender_id": {
      "type": "string",
      "description": "User ID of last message sender"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "participant_user_ids"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.participant_user_ids": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.participant_user_ids": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}