{
  "name": "Lead",
  "type": "object",
  "properties": {
    "lead_docket_id": {
      "type": "string",
      "description": "ID from Lead Docket CRM"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "State where legal help is needed"
    },
    "practice_area": {
      "type": "string",
      "description": "Type of legal matter"
    },
    "description": {
      "type": "string",
      "description": "Description of legal issue"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "junior_review",
        "senior_review",
        "approved",
        "rejected",
        "published",
        "routed_cochran",
        "closed"
      ],
      "default": "new"
    },
    "consent_given": {
      "type": "boolean",
      "default": false
    },
    "consent_ip": {
      "type": "string"
    },
    "consent_version": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "junior_reviewer": {
      "type": "string",
      "description": "Email of junior reviewer"
    },
    "junior_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "junior_recommendation": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "needs_info"
      ]
    },
    "senior_reviewer": {
      "type": "string",
      "description": "Email of senior reviewer"
    },
    "senior_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_value": {
      "type": "number",
      "description": "Estimated case value"
    },
    "source": {
      "type": "string",
      "default": "website"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "phone",
    "state",
    "practice_area"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": {
              "$in": [
                "admin",
                "senior_associate",
                "junior_associate"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "user_type": {
              "$in": [
                "admin",
                "senior_associate",
                "junior_associate"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_type": {
              "$in": [
                "admin",
                "senior_associate",
                "junior_associate"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}