{
  "name": "ResourceEvent",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "download",
        "open_link"
      ],
      "default": "download"
    }
  },
  "required": [
    "resource_id",
    "user_id",
    "action_type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}